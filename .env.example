# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Google Ads conversion tracking
# Example ID format: AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-REPLACE_WITH_YOUR_ID
# Conversion label from the Google Ads website conversion setup
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=REPLACE_WITH_CONVERSION_LABEL
